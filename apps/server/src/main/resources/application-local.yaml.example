# 本地环境配置模板。复制为 application-local.yaml 并填入真实值。
# 该文件含数据库口令与加密密钥，已在 .gitignore 中排除，严禁入库。
#
# 用户与节点数据现在都在数据库里，本文件不再承载任何绑定表。

server:
  # 本地开发只绑回环
  address: 127.0.0.1

spring:
  datasource:
    # 本地开发用的 MySQL；库需要提前建好，表由 Flyway 自动建
    url: "jdbc:mysql://127.0.0.1:3306/lane?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai"
    username: 填入数据库用户名
    password: 填入数据库口令
  security:
    oauth2:
      client:
        registration:
          logto:
            # Logto 里「传统 Web 应用」的凭据
            client-id: 填入 Logto 传统 Web 应用的 App ID
            client-secret: 填入 Logto 传统 Web 应用的 App Secret
            authorization-grant-type: authorization_code
            redirect-uri: "{baseUrl}/auth/callback"
            scope: openid,profile,email
        provider:
          logto:
            # Logto 租户的 OIDC issuer，形如 https://<tenant>.logto.app/oidc
            issuer-uri: "https://填入你的租户.logto.app/oidc"

lane:
  link:
    # 下发给客户端的配置有效期（秒）
    ttl-seconds: 1800
  auth:
    # 自签会话 token 的 HS256 密钥，至少 32 字节。生成：openssl rand -base64 32
    # 换了这个值，所有已登录会话（含桌面端钥匙串里的）全部失效
    session-secret: 填入生成的密钥
    # 本地开发时管理端 Vite 的地址
    admin-frontend-url: "http://localhost:5173"
  crypto:
    # 32 字节密钥的 Base64。生成：openssl rand -base64 32
    # 换了这个值，库里已有的密文全部解不开，必须重录所有凭据与节点密码
    key: 填入生成的密钥
