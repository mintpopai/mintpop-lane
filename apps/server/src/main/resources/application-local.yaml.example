# 本地环境配置模板。复制为 application-local.yaml 并填入真实值。
# 真实文件含加密密钥，已在 .gitignore 中排除，严禁入库。
# 节点池与用户绑定表已下沉到数据库（app_user / proxy_node），不再由本文件承载。

server:
  # 本地开发只绑回环
  address: 127.0.0.1

spring:
  security:
    oauth2:
      resourceserver:
        jwt:
          # Logto 租户的 OIDC issuer，形如 https://<tenant>.logto.app/oidc
          issuer-uri: "https://填入你的租户.logto.app/oidc"
          # 本服务在 Logto 中注册的 API Resource 标识，会与 JWT 的 aud 比对
          audiences:
            - "https://api.mintpop.internal"

mintpop:
  crypto:
    # Base64 编码的 32 字节（256 位）AES 密钥，用于加密节点敏感键与用户席位凭据
    key: 填入 Base64 编码的 32 字节密钥

  link:
    # 下发给客户端的配置有效期（秒）
    ttl-seconds: 1800
