# 生产环境配置模板。
# 部署时复制为 application-prod.yaml 放在 deploy/ 目录下，由 compose 以只读卷挂进容器，
# 不打进镜像。该文件含加密密钥，已在 .gitignore 中排除，严禁入库。
# 节点池与用户绑定表已下沉到数据库（app_user / proxy_node），不再由本文件承载。
#
# 注意：容器内不要设 server.address，必须绑 0.0.0.0；
# 不对外由 compose 的宿主端口只绑 127.0.0.1 保证。

spring:
  security:
    oauth2:
      resourceserver:
        jwt:
          issuer-uri: "https://填入你的租户.logto.app/oidc"
          audiences:
            - "https://api.mintpop.internal"

mintpop:
  crypto:
    # Base64 编码的 32 字节（256 位）AES 密钥，用于加密节点敏感键与用户席位凭据
    key: 填入 Base64 编码的 32 字节密钥

  link:
    ttl-seconds: 1800
