# 生产环境配置模板。
# 部署时复制为 application-prod.yaml 放在 deploy/ 目录下，由 compose 以只读卷挂进容器，
# 不打进镜像。该文件含节点与席位凭据，已在 .gitignore 中排除，严禁入库。
#
# 注意：容器内不要设 server.address，必须绑 0.0.0.0；
# 不对外由 compose 的宿主端口只绑 127.0.0.1 保证。

spring:
  security:
    oauth2:
      resourceserver:
        jwt:
          issuer-uri: "https://填入你的租户.logto.app/oidc"
          audiences:
            - "https://api.mintpop.internal"

mintpop:
  link:
    front:
      type: trojan
      server: us.example.com
      port: 443
      password: 填入机场节点密码
      sni: us.example.com

    users:
      - subject: 填入该用户在 Logto 中的 user id
        name: 张三
        status: ACTIVE
        expected-egress-ips:
          - 填入该用户专属落地代理的出口 IP
        land:
          type: socks5
          server: 填入落地代理地址
          port: 50101
          username: 填入用户名
          password: 填入密码
        claude-credential: 填入该席位 claude setup-token 生成的长效凭据

    ttl-seconds: 1800
