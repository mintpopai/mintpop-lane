# 生产环境配置模板。
# 部署时复制为 application-prod.yaml 放在 deploy/ 目录下，由 compose 以只读卷挂进容器，
# 不打进镜像。已在 .gitignore 中排除，严禁入库。
#
# 注意：容器内不要设 server.address，必须绑 0.0.0.0；
# 不对外由 compose 的宿主端口只绑 127.0.0.1 保证。
#
# 数据库连接与加密密钥不写在这里，而是由 compose 从 deploy/.env 注入成环境变量
# （SPRING_DATASOURCE_* 与 MINTPOP_CRYPTO_KEY），避免口令与配置文件一起被复制传阅。

spring:
  security:
    oauth2:
      resourceserver:
        jwt:
          issuer-uri: "https://填入你的租户.logto.app/oidc"
          audiences:
            - "https://api.mintpop.internal"

mintpop:
  link:
    ttl-seconds: 1800
  client:
    # Logto 中桌面端那个「原生应用」的 App ID，会随引导配置下发给桌面端
    logto-client-id: 填入 Logto 里那个原生应用的 App ID
