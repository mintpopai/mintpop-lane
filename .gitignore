# JetBrains 工程文件
.idea/

# Claude Code 本地配置
.claude/

# 系统文件
.DS_Store

# 依赖与构建产物
node_modules/
dist/
target/

# 本地链路配置（含真实节点凭据，严禁入库）
link.json
*.local

# 服务端配置（含数据库口令与加密密钥，严禁入库；模板见同目录 application.example.yml）
apps/server/config/application.yml

# 部署机上的服务端配置（含凭据，放仓库根、与 docker-compose.yml 同目录）
/application.yml

# 部署机上的环境变量文件（可选，覆盖镜像版本/端口/时区）
/.env

# mihomo sidecar 二进制，由 mise run fetch-mihomo 下载
apps/desktop/src-tauri/binaries/

# Tauri 构建时生成的 ACL schema
apps/desktop/src-tauri/gen/schemas/

# Superpowers SDD 工作区（临时产物，不入库）
.superpowers/

# 管理端本地开发的运行时配置（含 Logto 租户信息）
apps/admin/public/config.json

# 部署机上的管理端运行时配置
/admin-config.json
