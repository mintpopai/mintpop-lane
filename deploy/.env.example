# 复制为 .env 并填入真实值。该文件含口令与密钥，严禁入库。

# 镜像版本与宿主端口
SERVER_TAG=latest
SERVER_PORT=8081
ADMIN_TAG=latest
ADMIN_PORT=8082

# 外置 MySQL
MYSQL_URL=jdbc:mysql://10.0.0.10:3306/pier?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=pier
MYSQL_PASSWORD=填入数据库口令

# 加密密钥：openssl rand -base64 32
PIER_CRYPTO_KEY=填入生成的密钥
