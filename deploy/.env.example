# 复制为 .env 并填入真实值。该文件含口令与密钥，严禁入库。

# 服务端容器时区：订阅起止期按它判定，建议设成管理员所在时区
TZ=UTC

# 镜像版本与宿主端口
SERVER_TAG=latest
SERVER_PORT=8081
ADMIN_TAG=latest
ADMIN_PORT=8082

# 外置 MySQL
MYSQL_URL=jdbc:mysql://10.0.0.10:3306/lane?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=lane
MYSQL_PASSWORD=填入数据库口令

# 加密密钥：openssl rand -base64 32
LANE_CRYPTO_KEY=填入生成的密钥

# 自签会话 token 的签名密钥（≥32 字节）：openssl rand -base64 32
LANE_AUTH_SESSION_SECRET=填入生成的密钥

# Logto 传统 Web 应用的 App Secret（Logto 控制台该应用详情页可见）
LOGTO_CLIENT_SECRET=填入 Logto 传统 Web 应用的 App Secret
